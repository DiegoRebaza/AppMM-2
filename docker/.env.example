# Copia este archivo como ".env" (cp .env.example .env) y cambia los valores.
# El archivo .env NO se sube a GitHub.

# Contraseña de MySQL (usuario root)
MYSQL_ROOT_PASSWORD=cambia-esta-clave-mysql

# Secreto para firmar los JWT. Mínimo 32 caracteres. Es el MISMO para auth, producto, compra y contenido.
JWT_SECRET=cambia-este-secreto-jwt-de-al-menos-32-caracteres

# Clave para las llamadas internas compra -> producto
INTERNAL_API_KEY=cambia-esta-clave-interna-entre-servicios

# Administrador inicial que crea el servicio auth
ADMIN_EMAIL=admin@pasteleria.cl
ADMIN_PASSWORD=CambiaEstaClaveAdmin123!

# Orígenes del front permitidos (separados por coma)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
